# Copy this file to .env and adjust values for your local setup.

# PostgreSQL connection string consumed by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stam?schema=public"

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
